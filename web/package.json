{
  "name": "@procera/web",
  "private": true,
  "description": "Procera web app (workspace + system consoles). Design system foundations: BPMS-010.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && tsc -b && vite build",
    "preview": "vite preview --port 14173 --strictPort --host 127.0.0.1",
    "tokens": "node scripts/build-tokens.mjs",
    "check": "node scripts/build-tokens.mjs --check && node scripts/check-contrast.mjs && tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "1.55.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
