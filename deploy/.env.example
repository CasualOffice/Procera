# Procera — Docker Compose settings. Copy to deploy/.env and fill in every REQUIRED value.
# Keep deploy/.env out of version control: it holds your secrets.
# Every variable is described in docs/guides/configuration.md.

# --- REQUIRED secrets ----------------------------------------------------------------------------
# Generate each password with:  openssl rand -hex 24
# (hex keeps them safe inside the database URLs that compose.yml builds from them).
POSTGRES_PASSWORD=
PROCERA_MIGRATOR_DB_PASSWORD=
PROCERA_APP_DB_PASSWORD=

# Root key for secrets at rest and token signing (32 random bytes, base64). Generate it once with:
#   docker compose -f deploy/compose.yml run --rm --no-deps -T procera keygen
# (or `openssl rand -base64 32`). The server refuses to start without it.
# BACK IT UP somewhere safe. Losing it makes the encrypted data in the database unreadable.
PROCERA_MASTER_KEY=

# --- Address ---------------------------------------------------------------------------------------
# The address people type in their browser. Used in email links and for passkeys.
PROCERA_PUBLIC_URL=http://localhost:8080
# Host ports the web container publishes (HTTP, and HTTPS when PROCERA_SITE_ADDRESS is a domain).
PROCERA_HTTP_PORT=8080
PROCERA_HTTPS_PORT=8443
# ":80" serves plain HTTP. Set a domain (e.g. procera.example.com) to have Caddy fetch a TLS
# certificate automatically; then publish 80 and 443 (PROCERA_HTTP_PORT=80, PROCERA_HTTPS_PORT=443)
# and set PROCERA_PUBLIC_URL=https://procera.example.com.
PROCERA_SITE_ADDRESS=:80

# Cookies are Secure with the __Host- prefix by default, which needs HTTPS (browsers also allow
# them on http://localhost). Set true ONLY for a local trial over plain HTTP that isn't localhost.
PROCERA_INSECURE_COOKIES=false

# --- Email (optional) -------------------------------------------------------------------------------
# Leave empty to set up email later in the system console (Email & platform). A value here wins over
# the console's settings. Examples:
#   smtp://user:pass@smtp.example.com:587?tls=required
#   smtps://user:pass@smtp.example.com:465
#   smtp://mailpit:1025                      (with the `mail` profile, for testing)
PROCERA_SMTP_URL=
PROCERA_MAIL_FROM=Procera <no-reply@localhost>

# --- Optional services ------------------------------------------------------------------------------
# Turn on profiles here or with --profile: cache (Valkey), scan (ClamAV), mail (Mailpit).
# COMPOSE_PROFILES=cache,scan
# With the cache profile:
PROCERA_CACHE_URL=
#PROCERA_CACHE_URL=redis://valkey:6379
# With the scan profile (without it, only the EICAR test file is detected):
PROCERA_CLAMD_ADDR=
#PROCERA_CLAMD_ADDR=clamav:3310

# --- Tuning -----------------------------------------------------------------------------------------
# Log filter (tracing EnvFilter syntax), e.g. info, warn, procera=debug.
PROCERA_LOG=info
# Per-IP sign-in attempts per minute.
PROCERA_LOGIN_RATE_PER_MIN=30
# Passkey relying-party id; defaults to the host of PROCERA_PUBLIC_URL.
PROCERA_WEBAUTHN_RP_ID=
