{
  "schemaVersion": 1,
  "process": {
    "key": "it.access-request",
    "version": 1,
    "name": {
      "en": "Access request"
    },
    "criticality": "controlled"
  },
  "variables": [
    {
      "name": "system",
      "type": "string",
      "classification": "internal",
      "required": true
    },
    {
      "name": "access_role",
      "type": "string",
      "classification": "internal",
      "required": true
    },
    {
      "name": "sensitivity",
      "type": {
        "enum": [
          "standard",
          "high"
        ]
      },
      "classification": "internal",
      "required": true
    },
    {
      "name": "beneficiary",
      "type": "principal",
      "classification": "internal",
      "required": true
    },
    {
      "name": "justification",
      "type": "text",
      "classification": "internal",
      "required": true
    },
    {
      "name": "ticket_ref",
      "type": "string",
      "classification": "internal"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "name": {
        "en": "Request access"
      },
      "trigger": "manual",
      "inputForm": "access_request"
    },
    {
      "id": "by_sensitivity",
      "kind": "decision",
      "name": {
        "en": "Sensitive system?"
      },
      "branches": [
        {
          "name": "high",
          "when": "expr:feel: sensitivity = \"high\""
        }
      ]
    },
    {
      "id": "manager_approval",
      "kind": "human.approval",
      "name": {
        "en": "Manager approval"
      },
      "assignment": {
        "candidates": [
          {
            "type": "user",
            "ref": "expr:feel: beneficiary.manager"
          }
        ],
        "excludeInitiator": true,
        "fallback": {
          "type": "role",
          "ref": "process-owner"
        }
      },
      "due": {
        "after": "P2D",
        "business": true
      },
      "boundary": [
        {
          "on": "timeout",
          "after": "P5D",
          "interrupting": true,
          "to": "notify_expired"
        }
      ]
    },
    {
      "id": "owner_approval",
      "kind": "human.approval",
      "name": {
        "en": "System owner approval"
      },
      "assignment": {
        "candidates": [
          {
            "type": "role",
            "ref": "system-owner"
          }
        ],
        "excludeInitiator": true,
        "fallback": {
          "type": "role",
          "ref": "process-owner"
        }
      },
      "due": {
        "after": "P2D",
        "business": true
      }
    },
    {
      "id": "security_approval",
      "kind": "human.approval",
      "name": {
        "en": "Security approval"
      },
      "assignment": {
        "candidates": [
          {
            "type": "group",
            "ref": "security"
          }
        ],
        "excludeInitiator": true,
        "excludeActorsOf": [
          "owner_approval"
        ],
        "fallback": {
          "type": "role",
          "ref": "process-owner"
        }
      },
      "signature": "strong",
      "due": {
        "after": "P2D",
        "business": true
      }
    },
    {
      "id": "provision",
      "kind": "service.call",
      "name": {
        "en": "Provision access (connector hook point)"
      },
      "connector": "provisioning",
      "action": "grant_access",
      "input": {
        "system": "expr:feel: system",
        "role": "expr:feel: access_role",
        "user": "expr:feel: beneficiary.id"
      },
      "idempotencyKey": "expr:feel: instance.id + \":grant\""
    },
    {
      "id": "manual_provision",
      "kind": "human.task",
      "name": {
        "en": "IT provisions access manually"
      },
      "form": "provisioning_record",
      "assignment": {
        "candidates": [
          {
            "type": "group",
            "ref": "it-service-desk"
          }
        ]
      }
    },
    {
      "id": "notify_done",
      "kind": "notify",
      "name": {
        "en": "Access granted"
      },
      "channels": [
        "in_app",
        "email"
      ],
      "to": {
        "candidates": [
          {
            "type": "user",
            "ref": "expr:feel: beneficiary"
          }
        ]
      },
      "template": "access-granted"
    },
    {
      "id": "notify_rejected",
      "kind": "notify",
      "name": {
        "en": "Access rejected"
      },
      "channels": [
        "in_app",
        "email"
      ],
      "to": {
        "candidates": [
          {
            "type": "user",
            "ref": "expr:feel: initiator"
          }
        ]
      },
      "template": "access-rejected"
    },
    {
      "id": "notify_expired",
      "kind": "notify",
      "name": {
        "en": "Request expired"
      },
      "channels": [
        "in_app",
        "email"
      ],
      "to": {
        "candidates": [
          {
            "type": "user",
            "ref": "expr:feel: initiator"
          }
        ]
      },
      "template": "access-expired"
    },
    {
      "id": "end_granted",
      "kind": "end",
      "name": {
        "en": "Granted"
      }
    },
    {
      "id": "end_rejected",
      "kind": "end",
      "name": {
        "en": "Rejected"
      }
    },
    {
      "id": "end_expired",
      "kind": "end",
      "name": {
        "en": "Expired"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "start",
      "to": "by_sensitivity"
    },
    {
      "id": "e2",
      "from": "by_sensitivity",
      "to": "owner_approval",
      "on": "high"
    },
    {
      "id": "e3",
      "from": "by_sensitivity",
      "to": "manager_approval",
      "on": "default"
    },
    {
      "id": "e4",
      "from": "manager_approval",
      "to": "provision",
      "on": "approved"
    },
    {
      "id": "e5",
      "from": "manager_approval",
      "to": "notify_rejected",
      "on": "rejected"
    },
    {
      "id": "e6",
      "from": "manager_approval",
      "to": "notify_rejected",
      "on": "changes_requested"
    },
    {
      "id": "e7",
      "from": "owner_approval",
      "to": "security_approval",
      "on": "approved"
    },
    {
      "id": "e8",
      "from": "owner_approval",
      "to": "notify_rejected",
      "on": "rejected"
    },
    {
      "id": "e9",
      "from": "owner_approval",
      "to": "notify_rejected",
      "on": "changes_requested"
    },
    {
      "id": "e10",
      "from": "security_approval",
      "to": "provision",
      "on": "approved"
    },
    {
      "id": "e11",
      "from": "security_approval",
      "to": "notify_rejected",
      "on": "rejected"
    },
    {
      "id": "e12",
      "from": "security_approval",
      "to": "notify_rejected",
      "on": "changes_requested"
    },
    {
      "id": "e13",
      "from": "provision",
      "to": "notify_done",
      "on": "ok"
    },
    {
      "id": "e14",
      "from": "provision",
      "to": "manual_provision",
      "on": "error"
    },
    {
      "id": "e15",
      "from": "manual_provision",
      "to": "notify_done",
      "on": "submitted"
    },
    {
      "id": "e16",
      "from": "notify_done",
      "to": "end_granted"
    },
    {
      "id": "e17",
      "from": "notify_rejected",
      "to": "end_rejected"
    },
    {
      "id": "e18",
      "from": "notify_expired",
      "to": "end_expired"
    }
  ],
  "sla": [
    {
      "id": "sla_total",
      "scope": "instance",
      "target": "P3D",
      "business": true
    }
  ],
  "refs": {
    "forms": {
      "access_request": "form:it.access-request@1",
      "provisioning_record": "form:it.provisioning-record@1"
    },
    "connectors": {
      "provisioning": "connector:http-provisioning"
    },
    "calendars": {
      "default": "calendar:default@1"
    },
    "sop": "sop:access-management@1"
  },
  "meta": {
    "sourceFormat": "fixture",
    "templateRef": "tpl:it.access-request@1.0.0"
  }
}
